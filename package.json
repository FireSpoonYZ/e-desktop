{
  "name": "e-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config ui/vite.config.ts",
    "typecheck": "tsc --noEmit -p ui/tsconfig.json",
    "build": "npm run typecheck && vite build --config ui/vite.config.ts",
    "test": "node --test ui/tests/*.test.mjs ui/src/shell/*.test.mjs ui/src/commands/*.test.mjs",
    "tauri": "tauri",
    "postinstall": "node scripts/prepare-terminal-host.mjs --patch-only",
    "prepare:terminal-host": "node scripts/prepare-terminal-host.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.10.0-beta.300",
    "@xterm/xterm": "6.1.0-beta.303",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
